# Copy to .env. This is the central worker credential; camera membership is
# discovered dynamically from the portal database. Do not commit .env or put
# this value in application logs.
PORTAL_API_URL=http://localhost:3000
RECOGNITION_WORKER_TOKEN=
ENROLLMENT_SERVICE_TOKEN=
# Poll enabled cameras/configuration and owner-scoped identity indexes.
PORTAL_SYNC_INTERVAL=30
IDENTITY_SYNC_INTERVAL=60
